<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Devolver Livro"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <EditText
        android:id="@+id/editTextIsbnDevolver"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:hint="ISBN do Livro"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/textTitulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_devolver_livro_usuario"
        android:layout_width="180dp"
        android:layout_height="70dp"
        android:text="DEVOLVER"
        android:backgroundTint="@android:color/holo_blue_light"
        app:cornerRadius="15dp"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/editTextIsbnDevolver"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_voltar_devolver"
        android:layout_width="150dp"
        android:layout_height="70dp"
        android:text="VOLTAR"
        android:backgroundTint="@android:color/holo_orange_dark"
        app:cornerRadius="15dp"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/btn_devolver_livro_usuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>