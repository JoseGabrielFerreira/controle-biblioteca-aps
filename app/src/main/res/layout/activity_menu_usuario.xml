<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.MenuUsuarioActivity">

    <TextView
        android:id="@+id/bibliotecatextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Biblioteca Digital"
        android:textSize="34sp"
        android:fontFamily="@font/inter_semibold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/deescricaotextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Consulte livros e acompanhe seus empréstimos"
        android:textSize="16sp"
        android:fontFamily="@font/inter_medium"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/bibliotecatextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecione uma Opção"
        android:textSize="24sp"
        android:fontFamily="@font/inter_semibold"
        android:layout_marginTop="90dp"
        app:layout_constraintTop_toBottomOf="@id/deescricaotextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <Button
        android:id="@+id/btn_livros_usuario"
        android:layout_width="140dp"
        android:layout_height="62dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/design_default_color_secondary_variant"
        android:text="LIVROS"
        app:cornerRadius="15dp"
        app:layout_constraintEnd_toStartOf="@id/btn_emprestimos_usuario"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <Button
        android:id="@+id/btn_emprestimos_usuario"
        android:layout_width="170dp"
        android:layout_height="65dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="@color/design_default_color_secondary_variant"
        android:text="EMPRÉSTIMOS"
        app:cornerRadius="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btn_livros_usuario"
        app:layout_constraintTop_toBottomOf="@id/textView4" />

    <Button
        android:id="@+id/btn_devolver_usuario"
        android:layout_width="145dp"
        android:layout_height="74dp"
        android:layout_marginStart="28dp"
        android:backgroundTint="@android:color/holo_blue_light"
        android:text="DEVOLVER LIVRO"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_livros_usuario"
        app:layout_constraintVertical_bias="0.093" />

    <Button
        android:id="@+id/btn_sair_menu"
        android:layout_width="164dp"
        android:layout_height="72dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/design_default_color_error"
        android:text="SAIR"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.554"
        app:layout_constraintStart_toEndOf="@+id/btn_devolver_usuario"
        app:layout_constraintTop_toBottomOf="@+id/btn_emprestimos_usuario"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>